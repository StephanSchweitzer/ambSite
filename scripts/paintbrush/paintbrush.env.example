# Config for paintbrush.sh. Copy to .paintbrush.env next to the script:
#
#   cp paintbrush.env.example .paintbrush.env && chmod 600 .paintbrush.env
#
# .paintbrush.env is gitignored. No passwords belong in it — see README.md for
# the security model and the server-side key setup.

SSH_TARGET=user@example.com             # host running the mysqldump forced command
SSH_KEY=~/.ssh/paintbrush               # optional; this is the default
LOCAL_DB=my_site_local                  # overwritten every run — use a scratch DB
SITE_PATH=/Users/you/path/to/site       # project root; Claude Code opens this
WEB_ROOT=/Users/you/path/to/site/html   # optional; defaults to $SITE_PATH/html
PORT=8000

# Image sync. Needs its own read-only key and rsync 3.x (brew install rsync).
# Leave IMAGE_SYNC_TARGET empty to skip it.
IMAGE_SYNC_TARGET=images@example.com
IMAGE_SYNC_KEY=~/.ssh/paintbrush_images         # optional; this is the default
IMAGE_REMOTE_BASE=                              # empty if the key is rooted at the web root
IMAGE_DIRS="img imgMid thumbnails baseImages"   # quotes required — this file is sourced
