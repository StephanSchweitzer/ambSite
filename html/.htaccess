RewriteEngine On

RewriteCond %{HTTP_HOST} ^www.ambarvelasco.com$
RewriteRule ^(.*)$ http://ambarvelasco.com/$1 [R=301]

RewriteCond %{HTTP_HOST} ^www.ambarvelasco.com$
RewriteCond %{SERVER_PORT} ^443
RewriteRule ^(.*)$ https://ambarvelasco.com/$1 [R=301]

RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]