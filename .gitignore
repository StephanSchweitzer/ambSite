ambOldSite/
.idea/*
html/.idea/*
# Artwork images. These are uploaded through the live admin portal and live on
# the server; the local copies are pulled down read-only by paintbrush.sh purely
# so the practice site looks real. They are excluded from the deploy rsync, so
# git is not their home and tracking them only creates noise in every commit.
# html/miscIcons/ is deliberately NOT here — those are design assets that ship.
html/img/
html/imgMid/
html/thumbnails/
html/baseImages/

# Secrets — never commit
.env

# TLS material is managed on the server (Let's Encrypt), never in the repo
html/sslStuff/
*.key
*.pem

# SSH deploy keys — private key lives in GitHub secrets, public key on the server
amb_deploy_key
amb_deploy_key.pub
*_deploy_key
*_deploy_key.pub

# Local dev stack — machine-specific, never committed or deployed
dev/
