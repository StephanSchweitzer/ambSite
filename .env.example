# Copy to .env on the server, at the project root:
#   /var/www/ambarvelasco.com/.env
# That is one level above the web root (html/), so it is not web-accessible.
# .env is gitignored and must never be committed.
#
# This file is the full list of settings the code reads — every env() call in
# html/ appears below. Keep it that way: it is the only record of the config's
# shape, and the practice site on the Mac is checked against it.

APP_ENV=production

DB_HOST=localhost
DB_NAME=ambSite
DB_USER=
DB_PASSWORD=

# --- The shop -----------------------------------------------------------
# Without STRIPE_SECRET_KEY the shop is browsable but the basket says it is
# not taking orders yet. The publishable key must be the same mode (test or
# live) as the secret one, or the card box falls back to Stripe's own page.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# From the webhook endpoint in Stripe's dashboard, which should point at
# https://ambarvelasco.com/actions/stripeWebhook.php
STRIPE_WEBHOOK_SECRET=

# --- The shop's emails --------------------------------------------------
# Sent through Resend. Without a key nothing is sent and the admin page's
# Emails tab says so. The From domain must be verified in Resend.
RESEND_API_KEY=
SHOP_EMAIL_FROM="Ambar Velasco <shop@ambarvelasco.com>"

# --- Practice-site stand-ins (leave unset in production) ----------------
# These exist only so the practice copy can point at the mocks in dev/
# instead of the real services. Defaults are the real endpoints.
#STRIPE_API_BASE=https://api.stripe.com
#RESEND_API_BASE=https://api.resend.com
